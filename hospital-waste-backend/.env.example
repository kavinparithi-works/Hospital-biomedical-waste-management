# Copy this file to .env and fill in your values
MONGO_URI=mongodb://127.0.0.1:27017/biowaste_db
PORT=5000
TZ=Asia/Kolkata

# Secret used to sign login tokens — set a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Comma-separated list of allowed frontend origins (leave empty to allow all during development)
CORS_ORIGIN=

# Get a free Gemini API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
